# ---------------------------------------------------------------------------
# Voya ERP — environment configuration
# Copy to .env for local development. In production these are set in Coolify.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Postgres 16+. Coolify: point this at the internal service hostname.
DATABASE_URL="postgresql://voya:voya@localhost:5432/voya_erp?schema=public"
# Only needed for `prisma migrate dev` locally; not used in production.
SHADOW_DATABASE_URL="postgresql://voya:voya@localhost:5432/voya_erp_shadow?schema=public"
# Tests TRUNCATE every table, so they run against their own database and
# refuse to start if this is unset or equal to DATABASE_URL.
TEST_DATABASE_URL="postgresql://voya:voya@localhost:5432/voya_erp_test?schema=public"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-openssl-rand-base64-32"
# Public origin of the deployment, e.g. https://erp.voyatravel.bh
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Attachment storage -----------------------------------------------------
# Absolute path to a persistent volume. Coolify: mount a volume here.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/uploads"
# Max upload size in bytes (default 10 MB).
STORAGE_MAX_BYTES="10485760"

# --- Scheduled jobs ---------------------------------------------------------
# Bearer token required by /api/cron/notifications.
# Generate with: openssl rand -hex 32
CRON_SECRET="change-me-openssl-rand-hex-32"

# --- WhatsApp ---------------------------------------------------------------
# "manual" queues messages for staff to send via wa.me links (works with no
# credentials). "meta" dispatches through the WhatsApp Cloud API.
WHATSAPP_PROVIDER="manual"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Shared secret echoed back during Meta webhook verification.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Meta App Secret, used to verify the X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=""
# Where GROUP_CAPACITY_ALERT staff notifications are sent (E.164, comma separated).
WHATSAPP_STAFF_NUMBERS=""

# --- Notification timing ----------------------------------------------------
# Days before a balance due date to send the payment reminder.
REMINDER_BALANCE_DAYS_BEFORE="7"
# Days before membership expiry to send each renewal reminder — two stages.
REMINDER_MEMBERSHIP_DAYS_BEFORE="30"
REMINDER_MEMBERSHIP_DAYS_BEFORE_SHORT="7"
# Percentage of capacity that triggers a staff "nearly full" alert.
GROUP_CAPACITY_ALERT_THRESHOLD="80"

# --- Business defaults ------------------------------------------------------
# Base reporting currency. Bahraini Dinar uses 3 decimal places.
BASE_CURRENCY="BHD"
